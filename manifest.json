{
  "manifest_version": 3,
  "name": "Session Copy for Firefox",
  "description": "Copy and restore encrypted login sessions for any website. Offline, private, and built for secure transfer between browsers.",
  "version": "0.0.0",
  "author": "itinfra7",
  "homepage_url": "https://github.com/itinfra7/session-copy-firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "session-copy-firefox@itinfra7",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "Session Copy",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "64": "assets/icons/icon64.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "64": "assets/icons/icon64.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "cookies",
    "clipboardWrite",
    "clipboardRead",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
